# Development image used by docker compose. The production image is ./Dockerfile.
ARG RUBY_VERSION=3.3.12
FROM docker.io/library/ruby:$RUBY_VERSION-slim

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential git libpq-dev libyaml-dev pkg-config postgresql-client curl libvips && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

WORKDIR /rails
ENV BUNDLE_PATH="/usr/local/bundle"

COPY Gemfile Gemfile.lock .ruby-version ./
RUN bundle install && gem install foreman

COPY bin/docker-entrypoint-dev /usr/local/bin/docker-entrypoint-dev
ENTRYPOINT ["docker-entrypoint-dev"]

EXPOSE 3000
CMD ["bin/dev"]
