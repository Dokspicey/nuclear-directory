<%# One company linked to the plant or one of its units ("Constellation
    operates Byron 1"). Locals: link, profile. The plant isn't a link. Unit
    names usually carry the plant's ("Byron 1", "Ginna"); only a bare "Unit 3"
    gets the plant's name in front. %>
<% unit = link.facility.name %>
<% plant = if link.facility == profile.site then profile.name
           elsif unit.match?(/\AUnit\b/i) then "#{profile.name}, #{unit}"
           else unit
           end %>
<% share = "#{number_with_precision(link.ownership_pct, precision: 2, strip_insignificant_zeros: true)}% share" if link.ownership_pct %>
<% since = "#{link.started_on.future? ? "Starts" : "Since"} #{prose_month(link.started_on)}" if link.started_on %>
<%= render "shared/fact_row",
      sentence: safe_join([ link_to(link.organization.name, company_url_for(link.organization), class: "nd-link type-body-strong"),
                            " #{facility_relationship_verb(link.relationship_type)} ", plant ]),
      detail: [ share, link.description, since ].compact_blank.join(" · ").presence,
      evidence: link.evidence.max_by { |e| e.confidence || 0 },
      citations: profile.citations_for(link), confidence: link.confidence, checked: link.verified_at, correctable: true %>
