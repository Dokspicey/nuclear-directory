<%
  listing = @listing
  heading = if listing.category then listing.category.name
            elsif listing.searching? then "Results for “#{listing.query}”"
            else "All companies"
            end
  total = @companies.size + @plants.size
  # The plants category mixes plants, mines and test reactors (VOICE.md).
  noun, plural = if listing.category&.plants then [ "plant or site", "plants and sites" ]
                 elsif listing.searching? && listing.category.nil? then [ "result", "results" ]
                 else [ "company", "companies" ]
                 end
  content_for :title, "#{heading} · Nuclear Directory"
%>
<% content_for :head do %>
  <meta name="description" content="<%= listing.searching? ? "Companies and plants matching “#{listing.query}”" : "#{heading} in the US nuclear industry" %>, with the source for every fact.">
  <% if listing.searching? || listing.filtered? %><meta name="robots" content="noindex"><% end %>
<% end %>
<%= render "shared/site_header", query: listing.query %>

<main class="nd-page">
  <%= render "shared/category_pills", current: listing.category, counts: @counts %>

  <div class="nd-listhead">
    <h1 class="type-title-md nd-listhead__title"><%= heading %> <span class="type-data nd-listhead__count"><%= pluralize(total, noun, plural:) %></span></h1>

    <%# On phones the form opens in a full-screen sheet behind "Filters (N)" (#90).
        The form stays inline (its home) and only moves into the dialog while
        it's open. CSS picks the phone layout from first paint when scripting
        is on; without JavaScript the form is inline everywhere. %>
    <% active = [ listing.technology, listing.state ].compact.size %>
    <div class="nd-filterwrap" data-controller="filter-sheet" data-filter-sheet-count-url-value="<%= companies_path(format: :json) %>">
      <button type="button" class="nd-btn nd-btn--sm nd-filterwrap__open" data-action="filter-sheet#open" aria-haspopup="dialog">
        <%= icon("sliders-horizontal") %>Filters<% if active.positive? %> <span class="type-data">(<%= active %>)</span><% end %>
      </button>
      <div class="nd-filterwrap__home" data-filter-sheet-target="home">
        <%= form_with url: companies_path, method: :get, class: "nd-filters", data: { filter_sheet_target: "form", action: "change->filter-sheet#count" } do %>
          <%= hidden_field_tag :category, listing.category&.key, id: nil if listing.category %>
          <%= hidden_field_tag :q, listing.query, id: nil if listing.searching? %>
          <label class="nd-select"><b>Technology</b>
            <%= select_tag :technology, options_for_select(listing.technology_options, listing.technology), include_blank: "Any", class: "type-input" %>
          </label>
          <label class="nd-select"><b>State</b>
            <%= select_tag :state, options_for_select(listing.state_options, listing.state), include_blank: "Any", class: "type-input" %>
          </label>
          <label class="nd-select"><b>Sort</b>
            <%= select_tag :sort, options_for_select(DirectoryListing::SORTS.invert, listing.sort), class: "type-input" %>
          </label>
          <button type="submit" class="nd-btn nd-btn--sm" data-filter-sheet-target="submit">Apply filters</button>
        <% end %>
      </div>
      <dialog class="nd-filtersheet" aria-labelledby="filters-title" data-filter-sheet-target="dialog" data-action="cancel->filter-sheet#close close->filter-sheet#closed">
        <div class="nd-filtersheet__head">
          <h2 id="filters-title" class="type-body-strong">Filters</h2>
          <button type="button" class="nd-btn nd-btn--ghost nd-btn--sm" data-action="filter-sheet#close">Close filters</button>
        </div>
        <div class="nd-filtersheet__slot" data-filter-sheet-target="slot"></div>
        <p class="sr-only" role="status" data-filter-sheet-target="status"></p>
      </dialog>
    </div>
  </div>

  <% if total.zero? %>
    <% if listing.searching? %>
      <%= render "shared/empty_state", message: "No results for “#{listing.query}”#{" in #{listing.category.name}" if listing.category}.",
            action_label: "Clear search",
            action_url: directory_url_for(category: listing.category, technology: listing.technology, state: listing.state,
                                          sort: (listing.sort unless listing.sort == "name")) %>
    <% elsif listing.filtered? %>
      <%= render "shared/empty_state", message: "Nothing matches these filters.", action_label: "Clear filters", action_url: directory_url_for(category: listing.category) %>
    <% else %>
      <%= render "shared/empty_state", message: listing.category ? "Nothing verified in this category yet." : "No companies verified yet." %>
    <% end %>
  <% elsif listing.searching? && listing.category.nil? %>
    <%# Search results are always grouped, so each row's type is announced. %>
    <% if @companies.any? %>
      <section aria-labelledby="companies-heading">
        <h2 id="companies-heading" class="nd-label mb-1">Companies</h2>
        <ul class="nd-list"><% @companies.each do |company| %><%= render "shared/company_row", organization: company, connections: company.connections_count %><% end %></ul>
      </section>
    <% end %>
    <% if @plants.any? %>
      <section aria-labelledby="plants-heading">
        <h2 id="plants-heading" class="nd-label mb-1">Plants and sites</h2>
        <ul class="nd-list"><% @plants.each do |plant| %><%= render "shared/plant_row", facility: plant, connections: plant.connections_count %><% end %></ul>
      </section>
    <% end %>
  <% else %>
    <ul class="nd-list">
      <% @companies.each do |company| %><%= render "shared/company_row", organization: company, connections: company.connections_count %><% end %>
      <% @plants.each do |plant| %><%= render "shared/plant_row", facility: plant, connections: plant.connections_count %><% end %>
    </ul>
  <% end %>
</main>
