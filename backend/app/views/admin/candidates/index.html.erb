<% content_for :title, "Review queue" %>
<% filters = { queue: @queue, reason: @reason, run_id: @run_id }.compact %>

<div class="nd-stack">
  <h1 class="type-title-md m-0">Review queue</h1>
  <nav class="nd-pills" aria-label="Queues">
    <%= link_to admin_candidates_path(queue: "recommended"), class: "nd-pill", aria: { current: ("page" if @queue == "recommended") } do %>
      Recommended <span class="nd-num"><%= @counts[:recommended] %></span>
    <% end %>
    <%= link_to admin_candidates_path(queue: "needs_review"), class: "nd-pill", aria: { current: ("page" if @queue == "needs_review") } do %>
      Needs review <span class="nd-num"><%= @counts[:needs_review] %></span>
    <% end %>
  </nav>
  <p class="m-0 max-w-prose text-ink-muted">
    <% if @queue == "recommended" %>
      The verifier checked these claims against their sources and recommends publishing them. Nothing is published until you approve it.
    <% else %>
      These claims need a decision. Each one says why it's here.
    <% end %>
  </p>

  <% if @reasons.any? %>
    <%= form_with url: admin_candidates_path, method: :get, class: "nd-filters" do |form| %>
      <%= form.hidden_field :queue, value: @queue %>
      <%= form.hidden_field :run_id, value: @run_id if @run_id %>
      <label class="nd-select">
        <b>Reason</b>
        <%= form.select :reason, options_for_select([ [ "All reasons", "" ] ] + @reasons.map { |reason, count| [ "#{reason} (#{count})", reason ] }, @reason) %>
      </label>
      <%= form.submit "Filter", class: "nd-btn nd-btn--sm", name: nil %>
      <% if @reason || @run_id %><%= link_to "Clear filters", admin_candidates_path(queue: @queue), class: "nd-link nd-link--muted type-small" %><% end %>
    <% end %>
  <% end %>
</div>

<% if @items.empty? %>
  <%= render "shared/empty_state", message: (@reason || @run_id ? "No claims match these filters." : "Nothing is waiting in this queue."),
    action_label: ("Clear filters" if @reason || @run_id), action_url: admin_candidates_path(queue: @queue) %>
<% else %>
  <%= form_with url: approve_admin_candidates_path(filters), data: { controller: "select-all" } do %>
    <%# Enter in a reason field submits with the form's first button; a disabled
        one makes Enter do nothing, so every decision takes a deliberate click. %>
    <button type="submit" disabled hidden aria-hidden="true" tabindex="-1"></button>
    <div class="nd-bulk">
      <label><input type="checkbox" class="nd-check" data-select-all-target="all" data-action="select-all#toggle"> Select all on this page</label>
      <span class="nd-row">
        <span class="type-small text-ink-muted" data-select-all-target="count" aria-live="polite"></span>
        <button type="submit" class="nd-btn nd-btn--primary nd-btn--sm" data-turbo-confirm="Approve and publish every selected claim?">Approve selected</button>
      </span>
    </div>

    <ol class="nd-items">
      <% @items.each do |item| %>
        <%= render "item", item:, filters: %>
      <% end %>
    </ol>
  <% end %>

  <% if @items.size == Admin::CandidatesController::PAGE %>
    <div><%= link_to "Next #{Admin::CandidatesController::PAGE}", admin_candidates_path(filters.merge(after: @items.last.candidate_id)), class: "nd-btn nd-btn--sm" %></div>
  <% end %>
<% end %>
