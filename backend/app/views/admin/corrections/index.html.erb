<% content_for :title, "Correction requests" %>

<div>
  <h1 class="type-admin-h1">Correction requests <span class="type-count"><%= @counts["open"] %></span></h1>
  <p class="type-body text-ink-muted">From visitors</p>
</div>

<nav class="nd-fchips type-ui" aria-label="Requests">
  <% Admin::CorrectionsController::TABS.each do |tab| %>
    <%= link_to admin_corrections_path(tab:), class: "nd-fchip", aria: { current: ("page" if tab == @tab) } do %>
      <%= tab.humanize %> <span class="type-data nd-num"><%= @counts[tab] %></span>
    <% end %>
  <% end %>
</nav>

<% if @reports.empty? %>
  <p class="type-body text-ink-muted"><%= @tab == "open" ? "No open requests." : "None closed yet." %></p>
<% else %>
  <ol class="nd-waits">
    <% @reports.each do |report| %>
      <% record_path = @record_paths[report.id] %>
      <li class="nd-wait" id="report-<%= report.id %>">
        <div class="nd-wait__what">
          <p class="type-kicker text-ink-muted">
            <% if report.status == "reviewed" %>In progress · <%= who(report.decided_by) %>
            <% elsif report.status == "closed" %><%= report.resolution == "fixed" ? "Fixed" : "Dismissed" %> · <%= who(report.decided_by) %> · <%= data_date(report.decided_at) %>
            <% else %>New · <%= report.created_at.utc.strftime("%-d %b") %>
            <% end %>
          </p>
          <p class="type-subject"><%= report.subject %></p>
          <p class="type-small"><%= link_to report.page_path, report.page_path, class: "nd-link nd-link--muted wrap-anywhere", target: "_blank", rel: "noopener" %></p>
          <details>
            <summary class="type-small">Details</summary>
            <div class="nd-wait__more">
              <%# Plain text: links in a visitor's message aren't clickable; long ones wrap. %>
              <blockquote class="nd-quote type-body wrap-anywhere"><%= simple_format(h(report.message), {}, wrapper_tag: "span") %></blockquote>
              <p class="type-small text-ink-muted">
                Received <span class="nd-num"><%= report.created_at.utc.strftime("%Y-%m-%d %H:%M") %></span> UTC
                <% if record_path %> · <%= link_to "Open record", record_path, class: "nd-link nd-link--muted" %><% end %>
                <% if report.contact %> · <%= link_to "Reply to #{report.contact}", correction_reply_mailto(report), class: "nd-link nd-link--muted wrap-anywhere" %><% end %>
              </p>
            </div>
          </details>
        </div>
        <div class="nd-wait__actions type-ui">
          <% if report.status == "closed" %>
            <%= button_to "Reopen", reopen_admin_correction_path(report, tab: @tab), class: "nd-btn nd-btn--outline" %>
          <% else %>
            <%= button_to "Fix", fix_admin_correction_path(report, tab: @tab), class: "nd-btn nd-btn--primary", title: "Close as fixed" %>
            <%= button_to "Dismiss", dismiss_admin_correction_path(report, tab: @tab), class: "nd-btn nd-btn--outline" %>
            <% if report.status == "open" %>
              <%= button_to "Start", start_admin_correction_path(report, tab: @tab), class: "nd-btn nd-btn--outline", title: "Mark as in progress" %>
            <% end %>
          <% end %>
        </div>
      </li>
    <% end %>
  </ol>
  <% if @more %>
    <div><%= link_to "Next #{Admin::CorrectionsController::PAGE}", admin_corrections_path(tab: @tab, page: @page + 1), class: "nd-btn nd-btn--outline type-ui" %></div>
  <% end %>
<% end %>
