<% content_for :title, "Disclaimer · Nuclear Directory" %>
<% content_for :head do %>
  <meta name="description" content="Nuclear Directory is built from public sources. It may be incomplete or out of date, and it isn't safety or investment advice.">
<% end %>
<%= render "shared/site_header" %>

<main class="nd-page nd-page--narrow nd-prose">
  <h1 class="type-title-md">Disclaimer</h1>
  <div class="nd-prose__intro">
    <p class="type-body-strong">Nuclear Directory is a reference built from public sources.</p>
    <p class="type-body">Its sources are company announcements, regulator filings and news reports. Each fact links to the source it came from and shows when we last checked it.</p>
  </div>

  <section aria-labelledby="currency">
    <h2 id="currency" class="type-body-strong">It may be incomplete or out of date</h2>
    <p class="type-body">Check the source and its date before you rely on a fact.</p>
    <p class="type-small text-ink-muted">Companies change names, deals end and plans move.</p>
  </section>

  <section aria-labelledby="advice">
    <h2 id="advice" class="type-body-strong">It isn't advice</h2>
    <p class="type-body">Nothing here is safety, engineering, legal or investment advice.</p>
  </section>

  <section aria-labelledby="endorsement">
    <h2 id="endorsement" class="type-body-strong">Listing isn't endorsement</h2>
    <p class="type-body">A company, plant or deal appears because a source reports it, not because we recommend it.</p>
  </section>

  <section aria-labelledby="mistakes">
    <h2 id="mistakes" class="type-body-strong">Report mistakes and we'll check them</h2>
    <p class="type-body">Use "Report a correction" next to any fact, or email <%= mail_to DirectoryHelper::CORRECTIONS_EMAIL, nil, class: "nd-link" %>.</p>
    <p class="type-small text-ink-muted">We check every correction against its source.</p>
  </section>
</main>
