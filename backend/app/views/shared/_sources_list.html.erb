<%# The numbered list every source chip on the page points to. Locals:
    sources: [[number, source], ...] in number order
    A source without a title shows its URL instead. Only http(s) URLs
    become links; anything else is shown as text. %>
<ol class="nd-sources">
  <% sources.each do |number, source| %>
    <% href = safe_source_url(source) %>
    <li id="source-<%= number %>">
      <span class="nd-num"><%= number %></span>
      <span>
        <% if href %>
          <%= link_to source.title.presence || href, href, class: "nd-link", rel: "noopener noreferrer", target: "_blank" %>
        <% else %>
          <span><%= source.title.presence || source.url %></span>
        <% end %>
        <small><%= [ source_domain(source), ("published #{data_date(source.published_on)}" if source.published_on) ].compact_blank.join(" · ") %></small>
      </span>
    </li>
  <% end %>
</ol>
