<%# A citation that jumps to the numbered source list on the same page. Locals:
    number:  the source's number on the page
    source:  a Source
    compact: true shows the number only (inside the overview panel)
    checked: a date to show after the domain, e.g. the fact's last check (optional) %>
<% checked = local_assigns[:checked] unless local_assigns[:compact] %>
<% label = [ "Source #{number}: #{source_domain(source)}", ("checked #{data_date(checked)}" if checked) ].compact.join(", ") %>
<%= link_to "#source-#{number}", class: "nd-src", aria: { label: } do %>
  <sup><%= number %></sup><% unless local_assigns[:compact] %><%= source_domain(source) %><% if checked %> <span class="nd-src__checked">· checked <%= data_date(checked) %></span><% end %><% end %>
<% end %>
