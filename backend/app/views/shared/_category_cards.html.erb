<%# The home page's category cards (#362): a 5x2 grid on wide screens, an
    open stack on phones. Locals:
    cards: HomeCategories::Card list (buckets with companies, then Plants and sites)
    Wide screens: the header goes to the category's list. Phones: the header
    is a heading that the catstack controller turns into a button that opens
    and closes the card (all open at first, the choice remembered); "See all"
    is the category link there. Without JavaScript every card is open.
    Short cards get empty filler rows on wide screens, so cards in a row
    match; phones drop them. %>
<div class="nd-catgrid nd-catstack" data-controller="catstack">
  <button type="button" class="nd-catstack__all" data-catstack-target="all" data-action="catstack#toggleAll" hidden>Collapse all</button>
  <% cards.each do |card| %>
    <% category = card.category %>
    <% noun = category.plants ? pluralize(card.count, "plant or site", plural: "plants and sites") : pluralize(card.count, "company", plural: "companies") %>
    <% head = capture do %>
      <%= bucket_icon(category, size: 24) %>
      <span class="nd-catcard__name"><%= category.name %></span>
      <span class="nd-catcard__count"><span aria-hidden="true"><%= card.count %></span><span class="sr-only"><%= noun %></span></span>
    <% end %>
    <section class="nd-catcard nd-catcard--rows nd-catcard--compact nd-catcard--stack <%= bucket_class(category) %>" aria-label="<%= category.name %>"
             data-catstack-target="card" data-key="<%= category.key %>">
      <%= link_to directory_url_for(category:), class: "nd-catcard__head nd-catcard__head--link" do %><%= head %><% end %>
      <h2 class="nd-catcard__head nd-catcard__head--toggle" data-catstack-target="head"><%= head %></h2>
      <div class="nd-catcard__body" id="cat-body-<%= category.key %>">
        <div class="nd-catcard__inner">
          <ul class="nd-catcard__rows">
            <% card.records.each do |record| %>
              <li>
                <%= link_to (category.plants ? plant_url_for(record) : company_url_for(record)), class: "nd-catcard__row", title: record.name do %>
                  <span class="nd-catcard__rowname"><%= record.name %></span><span class="nd-catcard__chev" aria-hidden="true">›</span>
                <% end %>
              </li>
            <% end %>
            <% (HomeCategories::SHOWN - card.records.size).times do %><li class="nd-catcard__filler" aria-hidden="true"></li><% end %>
          </ul>
          <%= link_to directory_url_for(category:), class: "nd-catcard__more", aria: { label: "See all #{card.count} #{category.name}" } do %>
            <%= card.more? ? "See all #{card.count} ›" : "Open the list ›" %>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>
</div>
