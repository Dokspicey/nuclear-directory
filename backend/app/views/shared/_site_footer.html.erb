<%# The footer on every public page (#56). %>
<footer class="nd-footer">
  <nav class="nd-footer__links type-small" aria-label="About this site">
    <%= link_to "About", about_path, class: "nd-link nd-link--muted" %>
    <%= link_to "Privacy", privacy_path, class: "nd-link nd-link--muted" %>
    <%= link_to "Disclaimer", disclaimer_path, class: "nd-link nd-link--muted" %>
    <%= link_to "Our crawler", bot_path, class: "nd-link nd-link--muted" %>
    <%= mail_to DirectoryHelper::CORRECTIONS_EMAIL, nil, class: "nd-link nd-link--muted" %>
  </nav>
  <p class="type-small text-ink-muted">Built from public sources. Every fact links to where it came from.</p>
</footer>
