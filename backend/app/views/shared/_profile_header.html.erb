<%# The top of a company or power plant page. Locals:
    name:        the page's subject
    kind:        :company (initials in a square) or :plant (a ring)
    description: one plain line (optional; left out when unknown)
    citations:   [[number, source], ...] backing the description (optional)
    tags:        short labels, e.g. ["Reactor developer", "Fission"] (optional) %>
<section class="nd-profile" aria-labelledby="profile-name">
  <% if kind == :plant %>
    <span class="nd-ring nd-ring--lg" aria-hidden="true"><%= icon("factory", size: 24) %></span>
  <% else %>
    <span class="nd-mono nd-mono--md" aria-hidden="true"><%= initials(name) %></span>
  <% end %>
  <div class="nd-profile__main">
    <h1 id="profile-name" class="nd-profile__name"><%= name %></h1>
    <% if local_assigns[:description].present? %>
      <p class="nd-profile__desc"><%= description %><% Array(local_assigns[:citations]).each do |number, source| %><%= render "shared/source_chip", number:, source:, compact: true %><% end %></p>
    <% end %>
    <% if local_assigns[:tags].present? %>
      <div class="nd-row gap-1.5"><% tags.each do |tag_label| %><span class="nd-tag"><%= tag_label %></span><% end %></div>
    <% end %>
  </div>
</section>
