<%# The side panel of key facts on company and power plant pages. Locals:
    rows:        [[label, value, citations, note], ...]; a row with a blank value is
                 skipped. The note (optional) is a line of small print under the value
    verified_at: when the record was last checked
    verified:    false for a page whose own record isn't verified yet (a pending
                 site shown for its units): the date is labelled as the units' (optional)
    correction_url: where "Report a correction" goes (optional) %>
<% shown = rows.select { |_, value, _| value.present? } %>
<%# A value and its source numbers stay on one line together (Tosin: text
    never wraps): a short value shrinks to fit, down to 13px; a long one
    (a list of companies) wraps, with the numbers after its last word. %>
<aside class="nd-overview" aria-label="Key facts">
  <% if shown.any? %>
    <dl>
      <% shown.each do |label, value, citations, note| %>
        <%# Text fits; a block of its own (the Type chips) lays itself out, and
            goes under its label at the panel's full width, on every screen. %>
        <% stacked = value.to_s.include?("<ul") %>
        <% chars = stacked ? DirectoryHelper::FIT_CHARS + 1 : strip_tags(value.to_s).length %>
        <%= tag.dt(label, class: ("nd-overview__stack" if stacked)) %>
        <dd<%= ' class="nd-overview__stack"'.html_safe if stacked %>><span class="nd-overview__line<%= " nd-overview__line--fit" if chars <= DirectoryHelper::FIT_CHARS %>" style="--chars: <%= [ chars, 1 ].max %>; --cites: <%= Array(citations).size %>"><% cites = capture do %><% Array(citations).each do |number, source| %><%= render "shared/source_chip", number:, source:, compact: true %><% end %><% end %>
          <% if chars > DirectoryHelper::FIT_CHARS && citations.present? %>
            <%# A list wraps, but its last item and the numbers stay together. %>
            <%# Split only at ", " between items; HTML the page built stays HTML, plain text stays escaped. %>
            <% head, comma, last = value.to_s.rpartition(", ") %>
            <% head, last = [ head, last ].map(&:html_safe) if value.html_safe? %>
            <span class="nd-overview__val"><%= head %><%= comma %></span><span class="nd-keep"><%= comma.empty? ? value : last %><span class="nd-overview__cites"><%= cites %></span></span>
          <% else %>
            <span class="nd-overview__val"><%= value %></span><% if citations.present? %><span class="nd-overview__cites"><%= cites %></span><% end %>
          <% end %></span><% if note %><span class="block mt-1 type-small text-ink-muted"><%= note %></span><% end %></dd>
      <% end %>
    </dl>
  <% end %>
  <div class="nd-overview__foot">
    <% if local_assigns.fetch(:verified, true) %>
      <%= render "shared/verified_badge", verified_at: local_assigns[:verified_at] %>
    <% else %>
      <span class="nd-badge nd-badge--pending"><%= icon("clock", size: 12) %>Site not verified yet</span>
      <% if local_assigns[:verified_at] %><span class="type-data-sm text-ink-muted">units checked <%= data_date(verified_at) %></span><% end %>
    <% end %>
  </div>
  <% if local_assigns[:correction_url] %>
    <p class="type-small mt-3"><%= link_to "Report a correction", correction_url, class: "nd-link nd-link--muted nd-overview__fix" %></p>
  <% end %>
</aside>
