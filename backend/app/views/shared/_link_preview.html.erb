<%# Link previews on every public page (#90). A page may set content_for
    :og_title and :og_description; otherwise the title is the page's <title>
    and the description is the site's one line. The card image is shared,
    drawn by script/build_og_image.py. %>
<% og_description = content_for(:og_description).presence || "Who makes the fuel, builds the reactors, runs the plants, buys the power and funds it." %>
<meta property="og:type" content="website">
<meta property="og:site_name" content="Nuclear Directory">
<meta property="og:title" content="<%= content_for(:og_title).presence || content_for(:title).presence || "Nuclear Directory" %>">
<meta property="og:description" content="<%= og_description %>">
<%# The page's own address. A category is its own indexable page, so it keeps
    ?category=; other query strings (search, filters) are dropped. %>
<% category = Category.find(params[:category].to_s) if request.path == companies_path && params[:category].present? %>
<meta property="og:url" content="<%= request.base_url + request.path + (category ? "?#{ { category: category.to_param }.to_query }" : "") %>">
<meta property="og:image" content="<%= image_url("og-default.png") %>">
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Nuclear Directory: who makes the fuel, builds the reactors, runs the plants, buys the power and funds it.">
<meta name="twitter:card" content="summary_large_image">
