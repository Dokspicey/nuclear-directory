<% content_for :title, "Sign in" %>
<div class="nd-signin">
  <h1 class="type-title-md m-0">Sign in</h1>
  <%= form_with url: session_path, class: "nd-stack" do |form| %>
    <div class="nd-field">
      <%= form.label :email_address, "Email address", class: "type-ui" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "nd-input type-input" %>
    </div>
    <div class="nd-field">
      <%= form.label :password, "Password", class: "type-ui" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "nd-input type-input" %>
    </div>
    <div><%= form.submit "Sign in", class: "nd-btn nd-btn--primary" %></div>
  <% end %>
</div>
