<%# One deal on a company page, read left to right ("Google offtakes from
    Kairos Power"). Locals: deal, profile. The page's own company isn't a link. %>
<% from, to = [ deal.from_organization, deal.to_organization ].map do |o|
     o == profile.organization ? o.name : link_to(o.name, company_url_for(o), class: "nd-link type-body-strong")
   end %>
<%= render "shared/fact_row",
      sentence: safe_join([ from, " #{relationship_verb(deal.relationship_type)} ", to ]),
      detail: [ deal.description, prose_month(deal.started_on) ].compact_blank.join(" ").presence,
      quote: deal.evidence.max_by { |e| e.confidence || 0 }&.quote,
      citations: profile.citations_for(deal), confidence: deal.confidence, checked: deal.verified_at %>
