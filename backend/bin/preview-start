#!/usr/bin/env bash
# Start command for the free UI preview service (render.yaml,
# nuclear-directory-preview). Never used by the live site.
#
# Every start empties the preview database (its own, owned by preview_app;
# never production) and reloads schema and seed, so nothing from an earlier
# preview, including tables from another PR's migrations, survives.
set -euo pipefail

case "${DATABASE_URL:-}" in
  */nuclear_directory_preview|*/nuclear_directory_preview\?*) ;;
  *) echo "preview-start: DATABASE_URL must point at nuclear_directory_preview; refusing to reset it." >&2; exit 1 ;;
esac

# preview_app's 5-second statement_timeout protects the shared database from
# the running preview; the reset, schema load and seed below can take longer
# on the free instance, so these commands (only) get 2 minutes. The server
# started at the end doesn't inherit it.
reset_env=(PGOPTIONS="-c statement_timeout=120s -c lock_timeout=20s")

# During a deploy the old preview instance still holds connections and locks,
# which deadlocked DROP SCHEMA (#206). End the preview database's other
# sessions first (preview_app may end its own), and retry a few times in case
# the old instance reconnects in between.
reset_sql="
  SELECT count(pg_terminate_backend(pid)) FROM pg_stat_activity
  WHERE datname = current_database() AND pid <> pg_backend_pid() AND usename = current_user;
  DROP SCHEMA public CASCADE;
  CREATE SCHEMA public;"
for attempt in 1 2 3 4 5; do
  if env "${reset_env[@]}" psql "$DATABASE_URL" -X -q -v ON_ERROR_STOP=1 -c "$reset_sql" > /dev/null; then
    break
  fi
  if [[ $attempt == 5 ]]; then
    echo "preview-start: couldn't empty the preview database after 5 tries." >&2
    exit 1
  fi
  echo "preview-start: reset attempt ${attempt} failed; retrying in $((attempt * 3))s." >&2
  sleep $((attempt * 3))
done

env "${reset_env[@]}" bin/rails db:schema:load db:seed
# The preview's admin login, from PREVIEW_ADMIN_PASSWORD (skipped if unset).
env "${reset_env[@]}" bin/rails preview:admin
exec ./bin/rails server
