#!/usr/bin/env bash
# Restore test, run on a Mac from the repo root:
#
#   backup/restore-latest [release-tag]
#
# Copy the backup key (the whole "AGE-SECRET-KEY-1..." text from the password
# manager) to the clipboard first. Downloads the newest backup (or the given
# release) with the GitHub CLI, restores it into a fresh local database called
# nuclear_directory_restore_test, and prints row counts. The key goes from the
# clipboard straight into the container; it's never written to disk.
set -euo pipefail

repo="tosinoladokun/nuclear-directory-backups"
db="nuclear_directory_restore_test"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

key="$(pbpaste)"
if [[ "$key" != AGE-SECRET-KEY-1* ]]; then
  echo "Copy the backup key from the password manager first (it starts with AGE-SECRET-KEY-1)." >&2
  exit 1
fi

gh release download ${1:+"$1"} --repo "$repo" --pattern "*.dump.age" --dir "$work"
file="$(basename "$(ls "$work"/*.dump.age)")"
echo "Downloaded ${file}"

docker compose up --detach --wait db
docker compose exec -T db psql -U postgres --quiet \
  --command "DROP DATABASE IF EXISTS ${db}" --command "CREATE DATABASE ${db}"

printf '%s\n' "$key" | docker compose run --rm -T --volume "$work:/work:ro" backup \
  restore "/work/${file}" - "postgres://postgres:postgres@db:5432/${db}"

echo
echo "Compare these counts with the ones in the backup job's log on Render."
echo "Remove the test database with:"
echo "  docker compose exec db psql -U postgres -c 'DROP DATABASE ${db}'"
