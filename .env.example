# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Postgres connection. Leave the database name off in development: Rails
# picks nuclear_directory_development / nuclear_directory_test itself.
# In production, include it: postgres://user:pass@host:5432/nuclear_directory_production
DATABASE_URL=postgres://postgres:postgres@db:5432

# LLM calls go through OpenRouter (https://openrouter.ai/keys).
OPENROUTER_API_KEY=

# OpenRouter model ids (https://openrouter.ai/models), one per pipeline stage,
# so models can be swapped without code changes. They must differ: the
# verifier should be an independent second opinion, so these are also from
# different companies. Both are small, recent models at about $0.10 per million
# input tokens and $0.50 per million output tokens (October 2026).
OPENROUTER_EXTRACT_MODEL=openai/gpt-6-luna
OPENROUTER_VERIFY_MODEL=anthropic/claude-haiku-5.5

# Model spend per calendar month (US dollars) before the pipeline refuses
# further model calls. Keep it below the OpenRouter key's own credit limit.
DATA_QUALITY_MONTHLY_BUDGET=5

# Anonymous analytics (PostHog, cookieless; see backend/lib/analytics.rb).
# Leave POSTHOG_API_KEY empty to turn analytics off. The key is PostHog's
# public project key; it appears in page source by design.
POSTHOG_API_KEY=
POSTHOG_HOST=
