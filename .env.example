# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Postgres connection. Leave the database name off in development: Rails
# picks nuclear_directory_development / nuclear_directory_test itself.
# In production, include it: postgres://user:pass@host:5432/nuclear_directory_production
DATABASE_URL=postgres://postgres:postgres@db:5432

# LLM calls go through OpenRouter (https://openrouter.ai/keys).
OPENROUTER_API_KEY=

# OpenRouter model ids (https://openrouter.ai/models), one per pipeline stage,
# so models can be swapped without code changes.
OPENROUTER_EXTRACT_MODEL=
OPENROUTER_VERIFY_MODEL=
